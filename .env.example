# ─────────────────────────────────────────────────────────────
#  Cobro · variables de entorno
#  Copia este archivo a .env.local (desarrollo) y configura las
#  mismas variables en Vercel (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# Base de datos Postgres (Neon / Supabase / Azure). Si se deja vacío en
# desarrollo se usa PGlite (Postgres embebido) en ./.data/pglite
# Neon: usa la cadena "pooled" (…-pooler…) con ?sslmode=require
DATABASE_URL=

# URL pública de la app (se usa en los mensajes de WhatsApp/correo)
APP_URL=http://localhost:3000

# Acceso administrador
ADMIN_PASSWORD=cambia-esta-clave-larga
# Cadena aleatoria de 32+ caracteres para firmar sesiones:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Secreto del cron diario (Vercel lo envía como "Authorization: Bearer …")
CRON_SECRET=

# Zona horaria para calcular vencimientos
APP_TIMEZONE=America/Mexico_City

# ── Correo (opcional, gratis con Gmail/Workspace + contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Correo del administrador para el resumen diario
ADMIN_EMAIL=

# ── WhatsApp Cloud API de Meta (opcional; sin esto se usan enlaces wa.me)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=recordatorio_pago
WHATSAPP_TEMPLATE_LANG=es_MX
WHATSAPP_API_VERSION=v23.0

# ── Avisos de WhatsApp al administrador vía CallMeBot (opcional, gratis)
ADMIN_PHONE=
CALLMEBOT_APIKEY=
